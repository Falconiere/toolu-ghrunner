<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.toolu.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dev name/apps/toolu &amp; runner/toolu-runner</string>
    <string>run</string>
    <string>--all</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dev name/.toolu-runner</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/dev tools &amp; bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/dev name/.toolu-runner/_diag/service.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dev name/.toolu-runner/_diag/service.err.log</string>
</dict>
</plist>
