[Unit]
Description=toolu-runner (sh.toolu.runner)

[Service]
Environment="PATH=/opt/dev tools & bin:/usr/bin:/bin"
Environment="HOME=/root"
Environment="TOOLU_RUNNER_HOME=/Users/dev name/100%% \"toolu\" home"
ExecStart="/Users/dev name/apps/toolu & runner/toolu-runner" run --all
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
