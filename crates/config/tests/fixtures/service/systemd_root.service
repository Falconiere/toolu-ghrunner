[Unit]
Description=toolu-runner (io.toolu.runner.octocat.hello)

[Service]
Environment="PATH=/opt/homebrew/bin:/usr/bin:/bin"
Environment="HOME=/root"
Environment="TOOLU_RUNNER_HOME=/home/ci/.toolu-runner"
ExecStart="/usr/local/bin/toolu-runner" run --config "/home/ci/.toolu-runner/runners/octocat/hello/config.toml"
Restart=always
RestartSec=5
RestartPreventExitStatus=5

[Install]
WantedBy=multi-user.target
