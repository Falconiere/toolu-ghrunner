[Unit]
Description=toolu-runner (io.toolu.runner.octocat.hello)

[Service]
Environment="PATH=/opt/homebrew/bin:/usr/bin:/bin"
ExecStart="/opt/100%% $$rusty/toolu-runner" run --config "/home/ci/.toolu-runner/runners/octocat/hello/config.toml"
Restart=always
RestartSec=5
RestartPreventExitStatus=5

[Install]
WantedBy=default.target
