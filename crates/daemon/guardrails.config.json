{
  "$schema": "../../scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "nested": {
      "*": [
        "tests"
      ]
    },
    "requireReadme": [
      "docker",
      "routes"
    ]
  },
  "fileSize": {
    "max": 500,
    "skipExtensions": []
  },
  "functionSize": {
    "max": 150
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env"
    ]
  },
  "shadowConfigs": [],
  "ownedByLinter": []
}
