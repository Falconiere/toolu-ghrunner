{
  "$schema": "../../scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "nested": {
      "*": [
        "tests"
      ]
    },
    "requireReadme": []
  },
  "fileSize": {
    "max": 500,
    "skipExtensions": []
  },
  "functionSize": {
    "max": 150
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env"
    ],
    "scanExempt": [
      "tests/fixtures/job_message.json",
      "tests/gh_compat_context.rs",
      "tests/live_login_e2e.rs"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ],
  "ownedByLinter": []
}
